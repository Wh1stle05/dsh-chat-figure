    "图解",
    "插件"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wh1stle05/dsh-chat-figure.git"
  },
  "homepage": "https://github.com/Wh1stle05/dsh-chat-figure#readme",
  "bugs": {
    "url": "https://github.com/Wh1stle05/dsh-chat-figure/issues"
  },
  "scripts": {
    "test": "NODE_PATH=node_modules node smoke/smoke.mjs"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  },
  "dependencies": {
    "jsdom": "^30.1.3"
  }
